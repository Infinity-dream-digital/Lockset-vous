rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSalonAdmin() {
      return request.auth != null
        && request.auth.token.admin == true;
    }

    // Les visiteurs peuvent déposer une demande, mais ne peuvent pas lire les demandes.
    match /appointments/{appointmentId} {
      allow create: if request.resource.data.keys().hasOnly([
          'name', 'email', 'phone', 'service', 'date', 'time', 'message', 'status', 'createdAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 40
        && request.resource.data.service is string
        && request.resource.data.service.size() <= 120
        && request.resource.data.date is string
        && request.resource.data.time is string
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 2000
        && request.resource.data.status == 'À confirmer'
        && request.resource.data.createdAt == request.time;

      allow read, update, delete: if isSalonAdmin();
    }

    // Disponibilité du salon, modifiable et lisible uniquement par l’admin.
    match /settings/{settingId} {
      allow read, write: if isSalonAdmin() && settingId == 'salon';
    }
  }
}
